# =============================================================================
# .env.example: copy to `.env` and fill in ONLY what the current module needs.
#   Git Bash (Windows), macOS, Linux:  cp .env.example .env      (run from the repo root)
#   Fallbacks: Anaconda Prompt/cmd: copy .env.example .env  ·  PowerShell: Copy-Item .env.example .env
#   Step by step: modules/00-foundations/00-04-secrets-and-env.ipynb
# Never commit `.env`. It is listed in .gitignore.
# Variable names verified against official docs on 2026-10-11.
# =============================================================================

# --- Required from Module 00 -------------------------------------------------
# Groq API key: https://console.groq.com/keys
# Used by langchain-groq (ChatGroq) and the groq SDK (Whisper STT, Orpheus TTS).
GROQ_API_KEY=

# --- LangSmith tracing & evaluation (from Module 01, Lesson 01.08) -----------
# Create an API key in LangSmith: https://smith.langchain.com/
# Tracing quickstart: https://docs.langchain.com/langsmith/observability-quickstart
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Default project name. Notebooks override this per module (e.g. m01-comparison-lab).
LANGSMITH_PROJECT=langchain-langgraph-mastery
# Only needed for non-default regions/self-hosted instances. Leave empty otherwise.
# LANGSMITH_ENDPOINT=

# --- Web search (Module 05) ---------------------------------------------------
# Course default: Groq built-in browser search on openai/gpt-oss-* models.
#   No extra key needed: it uses GROQ_API_KEY.
#   https://console.groq.com/docs/tool-use/built-in-tools/browser-search
# Optional comparison: Tavily (1,000 free credits/month, no card, verified 2026-10-11).
#   https://docs.tavily.com/documentation/api-credits
MASTERY_WEB_SEARCH=groq
# TAVILY_API_KEY=

# --- Paid quality benchmark (optional; stretch goals, LLM-as-judge) ---------
# Course default benchmark: OpenAI. Guide: docs/paid-benchmark-openai-vs-gemini.md
# Models & prices: https://developers.openai.com/api/docs/models
#                  https://developers.openai.com/api/docs/pricing
# VERIFIED 2026-10-11: gpt-6-luna $0.10 in / $0.50 out per 1M tokens;
#                      gpt-6.1-sol $2.00 in / $10.00 out per 1M tokens.
OPENAI_API_KEY=
MASTERY_BENCHMARK_MODEL=openai:gpt-6-luna
MASTERY_BENCHMARK_MODEL_STRONG=openai:gpt-6.1-sol

# --- Google Gemini (REQUIRED for Module 10; optional benchmark elsewhere) ----
# Module 10 (Deep Agents) uses Gemini by default. Free tier, no billing account.
# Free tier = "Unpaid Services": Google may use prompts/responses to improve its
# products and human reviewers may read them. Public or synthetic data only.
# Free-tier limits are per project and per model, shown in Google AI Studio:
# https://ai.google.dev/gemini-api/docs/rate-limits
# LangChain reads GOOGLE_API_KEY first, then GEMINI_API_KEY.
# Keys: https://ai.google.dev/gemini-api/docs/api-key
# Models: https://ai.google.dev/gemini-api/docs/models
GOOGLE_API_KEY=
# Optional: use Gemini as the paid/low-cost benchmark instead of OpenAI.
# MASTERY_BENCHMARK_MODEL=google_genai:gemini-3.8-flash

# Anthropic (not used by default): https://platform.claude.com/docs/en/models/overview
# ANTHROPIC_API_KEY=

# --- Deep Agents (Module 10) ------------------------------------------------
# Deep Agents takes "provider:model" strings. Always pass a model explicitly
# (relying on the default model is deprecated and will be removed in 1.0).
# Course default for Module 10: Gemini 3.6 Flash (needs GOOGLE_API_KEY above).
# VERIFIED 2026-10-11: stable model ID (not preview), on the official Deep Agents
# suggested-models list (https://docs.langchain.com/oss/python/deepagents/models),
# free tier available. Paid list price $0.75 in / $3.75 out per 1M tokens until
# 2026-12-31, then $1.50 / $7.50. Pin this exact ID; do not use "-latest" aliases.
MASTERY_DEEP_MODEL=google_genai:gemini-3.6-flash
MASTERY_DEEP_SUBAGENT_MODEL=google_genai:gemini-3.6-flash
# Documented option: Groq (the rest of the course's default). Groq models are NOT in
# the official Deep Agents eval matrix, so validate them with your own evals.
# Groq free tier for gpt-oss-*: 8K tokens/min, 200K tokens/day (verified 2026-10-11,
# https://console.groq.com/docs/rate-limits). Full runs need the Developer plan.
# MASTERY_DEEP_MODEL=groq:openai/gpt-oss-120b
# MASTERY_DEEP_SUBAGENT_MODEL=groq:openai/gpt-oss-20b
# Web search inside deep agents still uses MASTERY_WEB_SEARCH above (Groq needs GROQ_API_KEY).
# Optional managed sandbox providers (Lesson 10.09). Never put these keys INSIDE a sandbox.
# DAYTONA_API_KEY=
# Modal authenticates with the `modal setup` CLI command instead of a key in this file.

# --- Hugging Face (Modules 06 and 14) -----------------------------------------
# Token for gated models and Inference Providers: https://huggingface.co/docs/inference-providers/index
HF_TOKEN=

# --- Local models (Module 14) -------------------------------------------------
# Default Ollama server address (change only if you run Ollama elsewhere).
OLLAMA_BASE_URL=http://localhost:11434

# --- Vector stores at scale (optional, Module 06 stretch) ---------------------
# PINECONE_API_KEY=

# --- Course model defaults (read by src/mastery/models.py) --------------------
# VERIFIED 2026-10-11 on https://console.groq.com/docs/models (re-check each module).
MASTERY_MODEL_FAST=openai/gpt-oss-20b
MASTERY_MODEL_REASONING=openai/gpt-oss-120b
# PREVIEW model (evaluation only, may be retired at short notice).
# Production note: use a production/GA vision model with an SLA, keep a fallback.
# See docs/production-notes.md and https://console.groq.com/docs/deprecations.
MASTERY_MODEL_VISION=qwen/qwen3.8-27b
MASTERY_MODEL_STT=whisper-large-v3-turbo
# PREVIEW model. Max 200 characters per request, WAV output only.
# Production note: use a GA TTS model with an SLA and a text-only fallback.
MASTERY_MODEL_TTS=canopylabs/orpheus-v1-english
MASTERY_TTS_VOICE=troy
# PREVIEW safety classifiers (Module 04). Never rely on one classifier alone.
MASTERY_MODEL_SAFETY=openai/gpt-oss-safeguard-20b
MASTERY_MODEL_PROMPT_GUARD=meta-llama/llama-prompt-guard-2-86m

# --- Project 01 (Multi-Model Comparison Lab) -----------------------------------
# Requests/second per model for the comparison batches. Default 0.13 fits the
# free tier (~8K tokens/min, ~1K tokens per call). Raise only if your Groq
# Limits page (https://console.groq.com/settings/limits) shows more.
# MASTERY_LAB_RPS=0.13

# --- Self-hosted service (Module 13) ------------------------------------------
# API key your FastAPI service expects in the X-API-Key header (make up a long random value).
# MASTERY_SERVICE_API_KEY=
# Postgres checkpointer used by Docker Compose (local only; never reuse these credentials).
# DATABASE_URL=postgresql://mastery:change-me@localhost:5432/mastery
